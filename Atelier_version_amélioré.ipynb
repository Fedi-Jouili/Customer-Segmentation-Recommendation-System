        "Retailer UK 2010-2011 | {len(df_raw):,} transactions | {len(customer_clean):,} clients | CA £{df_sales['Revenue'].sum():,.0f}\n",
        "K-Means k={OPTIMAL_K} | Silhouette {sil:.3f} | CH {ch:.1f} | DB {db:.3f}\n",
        "\n",
        "Segments :\n",
        "{cluster_summary}\n",
        "\n",
        "Top 5 produits : {', '.join(top5)}\n",
        "\n",
        "Structure : Résumé Exécutif | Résultats Clés | Recommandations | Prochaines Étapes\"\"\"\n",
        "\n",
        "    return call_groq(prompt, max_tokens=700)\n",

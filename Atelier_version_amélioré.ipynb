      "source": [
        "# ── 8.6  Business fiche per cluster ──────────────────────────────────────────\n",
        "SEGMENT_NAMES = {\n",
        "    0: 'Power Buyers',   1: 'Occasional Explorers',\n",
        "    2: 'At-Risk Dormant', 3: 'Loyal Regulars',\n",
        "    4: 'Bargain Seekers', 5: 'New Activators',\n",
        "    6: 'High-Cancellers', 7: 'International Niche'\n",
        "}\n",
        "\n",
        "def build_fiche(cluster_id, df):\n",
        "    sub = df[df['Cluster'] == cluster_id]\n",
        "    name = SEGMENT_NAMES.get(cluster_id, f'Segment {cluster_id}')\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"🎯 Cluster {cluster_id} — {name}  (n={len(sub):,})\")\n",
        "    print(f\"{'='*60}\")\n",
        "    print(f\"📊 KPIs:\")\n",
        "    print(f\"   Recency (days)     : {sub['Recency'].mean():.0f}\")\n",
        "    print(f\"   Frequency (orders) : {sub['Frequency'].mean():.1f}\")\n",
        "    print(f\"   Monetary (£)       : {sub['Monetary'].mean():.0f}\")\n",
        "    print(f\"   AOV (£)            : {sub['AOV'].mean():.0f}\")\n",
        "    print(f\"   Cancellation Rate  : {sub['Cancellation_Rate'].mean():.2%}\")\n",
        "    print(f\"   Unique Products    : {sub['Unique_Products_Purchased'].mean():.0f}\")\n",
        "    print(f\"🔑 Top Country : {df_sales[df_sales['CustomerID'].isin(sub.index)]['Country'].mode().iloc[0]}\")\n",
        "\n",
        "for cid in range(OPTIMAL_K):\n",
        "    build_fiche(cid, customer_clean)\n"
      ]
    },

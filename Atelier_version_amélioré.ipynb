          "text": [
            "Bootstrap Stability (n_boot=10, subsample=80%)\n",
            "  Mean ARI : 0.9051\n",
            "  Std  ARI : 0.0715\n",
            "  → ✅ Highly stable clusters\n"
          ]
        }
      ],
      "source": [
        "# ── 7.4  Bootstrap Stability [Von Luxburg, 2010] ─────────────────────────────\n",
        "def bootstrap_stability(X, k, n_boot=10, subsample=0.8, random_state=42):\n",
        "    \"\"\"\n",
        "    Fit K-Means on n_boot random 80% subsamples and compare cluster labels\n",
        "    via Adjusted Rand Index (ARI) against the full-data solution.\n",
        "    High mean ARI → stable clusters. [Von Luxburg, 2010]\n",
        "    \"\"\"\n",
        "    rng = np.random.RandomState(random_state)\n",
        "    km_full = KMeans(n_clusters=k, random_state=random_state, n_init=10)\n",
        "    labels_full = km_full.fit_predict(X)\n",
        "\n",
        "    aris = []\n",
        "    n = len(X)\n",
        "    for _ in range(n_boot):\n",
        "        idx = rng.choice(n, size=int(n * subsample), replace=False)\n",
        "        km_sub = KMeans(n_clusters=k, random_state=random_state, n_init=5)\n",
        "        sub_labels = km_sub.fit_predict(X[idx])\n",
        "        full_sub_labels = labels_full[idx]\n",
        "        aris.append(adjusted_rand_score(full_sub_labels, sub_labels))\n",
        "\n",
        "    return np.mean(aris), np.std(aris)\n",
        "\n",
        "mean_ari, std_ari = bootstrap_stability(X_pca, OPTIMAL_K, n_boot=10,\n",
        "                                         random_state=RANDOM_STATE)\n",
        "print(f\"Bootstrap Stability (n_boot=10, subsample=80%)\")\n",
        "print(f\"  Mean ARI : {mean_ari:.4f}\")\n",
        "print(f\"  Std  ARI : {std_ari:.4f}\")\n",
        "if mean_ari > 0.8:\n",
        "    print(\"  → ✅ Highly stable clusters\")\n",
        "elif mean_ari > 0.6:\n",
        "    print(\"  → ⚠️  Moderately stable — acceptable\")\n",
        "else:\n",
        "    print(\"  → ❌ Unstable — consider different k or feature set\")\n"
      ]
    },

      "source": [
        "# ── 6.4  Final K-Means ───────────────────────────────────────────────────────\n",
        "# Consensus: choose k that appears most frequently across methods\n",
        "from collections import Counter\n",
        "k_votes = Counter([best_k_silhouette, best_k_gap])\n",
        "OPTIMAL_K = k_votes.most_common(1)[0][0]\n",
        "# Safety override — if all differ, prefer silhouette\n",
        "if len(k_votes) == len(set([best_k_silhouette, best_k_gap])):\n",
        "    OPTIMAL_K = best_k_silhouette\n",
        "\n",
        "print(f\"Elbow method suggests: (inspect plot)\")\n",
        "print(f\"Silhouette best k    : {best_k_silhouette}\")\n",
        "print(f\"Gap Statistic best k : {best_k_gap}\")\n",
        "print(f\">>> CHOSEN k         : {OPTIMAL_K}\")\n",
        "\n",
        "kmeans = KMeans(n_clusters=OPTIMAL_K, random_state=RANDOM_STATE, n_init=20)\n",
        "kmeans_labels = kmeans.fit_predict(X_pca)\n",
        "\n",
        "customer_clean = customer_clean.copy()\n",
        "customer_clean['Cluster'] = kmeans_labels\n",
        "X_pca_df['Cluster'] = kmeans_labels\n",
        "print(f\"\\nCluster distribution:\")\n",
        "print(customer_clean['Cluster'].value_counts().sort_index())\n"
      ]

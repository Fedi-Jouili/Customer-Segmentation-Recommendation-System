      "source": [
        "# ── 5.2  RobustScaler ────────────────────────────────────────────────────────\n",
        "# RobustScaler uses median + IQR → less sensitive to residual outliers\n",
        "# than StandardScaler which uses mean + std [Müller & Guido, 2016, p. 44]\n",
        "scaler = RobustScaler()\n",
        "X_scaled = pd.DataFrame(scaler.fit_transform(X_clean),\n",
        "                         columns=FEAT_COLS, index=X_clean.index)\n",
        "print(\"Scaling complete.\")\n",
        "X_scaled.describe().T[['mean','std','min','max']]\n"
      ]
    },

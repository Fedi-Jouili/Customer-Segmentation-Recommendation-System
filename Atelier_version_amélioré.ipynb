      ],
      "source": [
        "# ── 1.3  Day-of-week & hour heatmap ──────────────────────────────────────────\n",
        "dow_order = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']\n",
        "pivot = df_tmp.groupby(['DayOfWeek','Hour']).size().unstack(fill_value=0)\n",
        "pivot = pivot.reindex(dow_order)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(14, 5))\n",
        "sns.heatmap(pivot, cmap='YlOrRd', linewidths=0.3, ax=ax,\n",
        "            cbar_kws={'label': 'Number of Transactions'})\n",
        "ax.set_title('🕐 Transaction Heatmap — Day of Week × Hour', fontsize=14)\n",
        "ax.set_xlabel('Hour of Day'); ax.set_ylabel('')\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },
    {

        "# ── GenAI Setup (Groq) ───────────────────────────────────────────────────────────────\n",
        "!pip install groq   # à exécuter une seule fois pour installer le SDK\n",
        "\n",
        "import os, time, logging\n",
        "from groq import Groq\n",
        "\n",
        "# Initialise le client Groq avec ta clé API\n",
        "groq_client = Groq(api_key=\"""\")  # ← remplace par ta clé réelle\n",
        "GROQ_MODEL = \"llama-3.3-70b-versatile\"        # modèle gratuit rapide\n",
        "\n",
        "def call_groq(prompt: str, max_tokens: int = 600) -> str:\n",
        "    \"\"\"\n",
        "    Envoie un prompt au modèle Groq et renvoie la réponse textuelle.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        resp = groq_client.chat.completions.create(\n",
        "            model=GROQ_MODEL,\n",
        "            max_tokens=max_tokens,\n",
        "            messages=[{\"role\": \"user\", \"content\": prompt}]\n",
        "        )\n",
        "        time.sleep(1)  # petit délai pour éviter surcharge\n",
        "        return resp.choices[0].message.content\n",
        "    except Exception as e:\n",
        "        logging.error(f\"Groq error: {e}\")\n",
        "        return f\"[Erreur] {e}\"\n",
        "\n",
        "print(\"✅ GenAI setup avec Groq prêt. API key détectée :\", bool(groq_client))\n"
      ]

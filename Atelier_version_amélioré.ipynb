      "source": [
        "# ── 1.7  Seasonal decomposition (monthly revenue) ────────────────────────────\n",
        "monthly_rev = (df_tmp[df_tmp['Revenue'] > 0]\n",
        "               .groupby('YearMonth')['Revenue']\n",
        "               .sum())\n",
        "monthly_rev.index = pd.PeriodIndex(monthly_rev.index, freq='M').to_timestamp()\n",
        "monthly_rev = monthly_rev.sort_index()\n",
        "\n",
        "# Need at least 2 full cycles — additive with period=6\n",
        "decomp = seasonal_decompose(monthly_rev, model='additive', period=6,\n",
        "                             extrapolate_trend='freq')\n",
        "\n",
        "fig, axes = plt.subplots(4, 1, figsize=(14, 10), sharex=True)\n",
        "for ax, data, label in zip(axes,\n",
        "    [monthly_rev, decomp.trend, decomp.seasonal, decomp.resid],\n",
        "    ['Observed', 'Trend', 'Seasonal', 'Residual']):\n",
        "    ax.plot(data, color='steelblue'); ax.set_ylabel(label); ax.grid(True, alpha=0.3)\n",
        "axes[0].set_title('Seasonal Decomposition of Monthly Revenue (Additive model)', fontsize=13)\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },

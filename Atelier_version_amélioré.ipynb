      "source": [
        "# ── 8.4  Histograms grid ─────────────────────────────────────────────────────\n",
        "HIST_FEATS = ['Recency','Frequency','Monetary','AOV','Unique_Products_Purchased',\n",
        "              'Cancellation_Rate']\n",
        "n_rows = len(HIST_FEATS)\n",
        "fig, axes = plt.subplots(n_rows, OPTIMAL_K, figsize=(5*OPTIMAL_K, 3.5*n_rows))\n",
        "cmap = plt.cm.tab10(np.linspace(0, 1, OPTIMAL_K))\n",
        "\n",
        "for row, feat in enumerate(HIST_FEATS):\n",
        "    for col in range(OPTIMAL_K):\n",
        "        ax = axes[row][col] if OPTIMAL_K > 1 else axes[row]\n",
        "        data = customer_clean[customer_clean['Cluster'] == col][feat]\n",
        "        ax.hist(data, bins=30, color=cmap[col], edgecolor='white', alpha=0.85)\n",
        "        ax.set_title(f'C{col} — {feat}', fontsize=9)\n",
        "        ax.set_xlabel(feat, fontsize=8)\n",
        "plt.suptitle('Feature Distributions per Cluster', fontsize=14, y=1.01)\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },

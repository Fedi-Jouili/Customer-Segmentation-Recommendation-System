      "source": [
        "# ── 5.5  Apply PCA ────────────────────────────────────────────────────────────\n",
        "pca = PCA(n_components=n_components_85, random_state=RANDOM_STATE)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "X_pca_df = pd.DataFrame(X_pca, index=X_scaled.index,\n",
        "                          columns=[f'PC{i+1}' for i in range(n_components_85)])\n",
        "\n",
        "# Align customer_df index\n",
        "customer_clean = customer_df.loc[X_clean.index].copy()\n",
        "\n",
        "# 2D visualisation coloured by RFM segment\n",
        "fig = px.scatter(x=X_pca_df['PC1'], y=X_pca_df['PC2'],\n",
        "                 color=customer_clean['RFM_Segment'].values,\n",
        "                 title='🔵 PCA 2D — Coloured by RFM Segment',\n",
        "                 labels={'x':'PC1','y':'PC2'})\n",
        "fig.show()\n"
      ]
    },

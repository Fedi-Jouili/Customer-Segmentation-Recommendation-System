      "source": [
        "# ── 8.2  Radar chart ─────────────────────────────────────────────────────────\n",
        "RADAR_FEATS = ['Recency','Frequency','Monetary','AOV',\n",
        "               'Unique_Products_Purchased','Cancellation_Rate',\n",
        "               'Avg_Days_Between_Purchases','Weekend_Purchase_Ratio']\n",
        "\n",
        "angles = np.linspace(0, 2*np.pi, len(RADAR_FEATS), endpoint=False).tolist()\n",
        "angles += angles[:1]  # close the polygon\n",
        "\n",
        "fig, axes = plt.subplots(1, OPTIMAL_K, figsize=(5*OPTIMAL_K, 5),\n",
        "                          subplot_kw={'polar': True})\n",
        "if OPTIMAL_K == 1:\n",
        "    axes = [axes]\n",
        "\n",
        "colors = plt.cm.tab10(np.linspace(0, 1, OPTIMAL_K))\n",
        "for i, ax in enumerate(axes):\n",
        "    vals = centroid_norm.loc[i, RADAR_FEATS].values.tolist()\n",
        "    vals += vals[:1]\n",
        "    ax.plot(angles, vals, color=colors[i], linewidth=2)\n",
        "    ax.fill(angles, vals, color=colors[i], alpha=0.25)\n",
        "    ax.set_xticks(angles[:-1])\n",
        "    ax.set_xticklabels(RADAR_FEATS, fontsize=7)\n",
        "    ax.set_title(f'Cluster {i}', color=colors[i], fontweight='bold', pad=15)\n",
        "    ax.set_ylim(0, 1)\n",
        "\n",
        "plt.suptitle('Radar Chart — Cluster Profiles (normalised)', fontsize=14, y=1.02)\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },

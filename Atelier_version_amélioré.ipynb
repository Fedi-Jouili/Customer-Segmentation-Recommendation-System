      "source": [
        "# ── 6.2  Silhouette Analysis ─────────────────────────────────────────────────\n",
        "silhouette_scores = []\n",
        "for k in K_RANGE:\n",
        "    km = KMeans(n_clusters=k, random_state=RANDOM_STATE, n_init=10)\n",
        "    labels = km.fit_predict(X_pca)\n",
        "    s = silhouette_score(X_pca, labels)\n",
        "    silhouette_scores.append(s)\n",
        "    print(f\"k={k}  silhouette={s:.4f}\")\n",
        "\n",
        "best_k_silhouette = list(K_RANGE)[np.argmax(silhouette_scores)]\n",
        "print(f\"\\nBest k by silhouette: {best_k_silhouette}\")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9,4))\n",
        "ax.plot(list(K_RANGE), silhouette_scores, marker='s', color='coral')\n",
        "ax.axvline(x=best_k_silhouette, color='red', linestyle='--',\n",
        "           label=f'Best k={best_k_silhouette}')\n",
        "ax.set_xlabel('k'); ax.set_ylabel('Silhouette Score')\n",
        "ax.set_title('Silhouette Score vs k'); ax.legend()\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "id": "0cfd430c",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 508
        },
        "id": "0cfd430c",
        "outputId": "b44fdabd-8ad7-43f1-855a-0b473cb9b84f"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Computing Gap Statistic (B=10 reference distributions)…\n"
          ]
        },
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 1080x480 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        },
        {
          "name": "stdout",

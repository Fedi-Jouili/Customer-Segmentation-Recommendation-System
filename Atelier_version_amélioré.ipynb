        "def generate_executive_summary():\n",
        "    cluster_summary = \"\\n\".join(\n",
        "        f\"  Cluster {cid} ({SEGMENT_NAMES.get(cid,'Segment '+str(cid))}): \"\n",
        "        f\"{(customer_clean['Cluster']==cid).sum():,} clients, \"\n",
        "        f\"£{customer_clean[customer_clean['Cluster']==cid]['Monetary'].mean():.0f} moy\"\n",
        "        for cid in range(OPTIMAL_K)\n",
        "    )\n",
        "    top5 = df_sales.groupby('Description')['Revenue'].sum().nlargest(5).index.tolist()\n",
        "\n",
        "    prompt = f\"\"\"Rédige un résumé exécutif ~300 mots en français pour le board.\n",

      "source": [
        "# ── 2.6  Apply cleaning ───────────────────────────────────────────────────────\n",
        "df = df_raw.copy()\n",
        "df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'])\n",
        "df['InvoiceNo']   = df['InvoiceNo'].astype(str)\n",
        "\n",
        "# Flag cancelled invoices before removing them\n",
        "df['IsCancelled'] = df['InvoiceNo'].str.startswith('C')\n",
        "cancelled_df = df[df['IsCancelled']].copy()\n",
        "\n",
        "# Drop exact duplicates\n",
        "df = df.drop_duplicates()\n",
        "\n",
        "# Drop missing CustomerID and Description\n",
        "df = df.dropna(subset=['CustomerID', 'Description'])\n",
        "\n",
        "# Drop zero/negative UnitPrice (NOT quantity — keep for returns_df)\n",
        "returns_df = df[df['Quantity'] < 0].copy()\n",
        "df = df[df['UnitPrice'] > 0].copy()\n",
        "\n",
        "# Remove cancelled from main\n",
        "df_sales = df[~df['IsCancelled']].copy()\n",
        "df_sales = df_sales[df_sales['Quantity'] > 0].copy()\n",
        "\n",
        "# Revenue column\n",
        "df_sales['Revenue'] = df_sales['Quantity'] * df_sales['UnitPrice']\n",
        "\n",
        "# Fix CustomerID dtype\n",
        "df_sales['CustomerID'] = df_sales['CustomerID'].astype(int)\n",
        "\n",
        "# Resolve description inconsistency — modal description per StockCode\n",
        "modal_desc = df_sales.groupby('StockCode')['Description'].agg(\n",
        "    lambda x: x.value_counts().index[0])\n",
        "df_sales['Description'] = df_sales['StockCode'].map(modal_desc)\n",
        "\n",
        "print(f\"Clean sales DataFrame: {df_sales.shape}\")\n",
        "print(f\"Unique customers     : {df_sales['CustomerID'].nunique():,}\")\n",
        "df_sales.head(3)\n"
      ]
    },

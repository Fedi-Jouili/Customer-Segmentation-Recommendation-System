      "source": [
        "# ── 8.1  Normalised centroids ────────────────────────────────────────────────\n",
        "centroid_df = (customer_clean.groupby('Cluster')[FEAT_COLS]\n",
        "               .mean())\n",
        "# Normalise 0–1 for radar charts\n",
        "centroid_norm = (centroid_df - centroid_df.min()) / (centroid_df.max() - centroid_df.min() + 1e-9)\n",
        "centroid_norm\n"
      ]
    },

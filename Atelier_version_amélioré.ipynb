        "def analyze_churn_risk(customer_id):\n",
        "    if customer_id not in customer_clean.index:\n",
        "        return \"Client introuvable.\"\n",
        "    p = customer_clean.loc[customer_id]\n",
        "\n",
        "    signals = []\n",
        "    if p['Recency']           > customer_clean['Recency'].quantile(0.75):\n",
        "        signals.append(f\"Inactif depuis {p['Recency']:.0f} jours\")\n",
        "    if p['Frequency']         < customer_clean['Frequency'].quantile(0.25):\n",
        "        signals.append(f\"Faible fréquence ({p['Frequency']:.0f} commandes)\")\n",
        "    if p['Cancellation_Rate'] > 0.1:\n",
        "        signals.append(f\"Taux d'annulation élevé ({p['Cancellation_Rate']:.1%})\")\n",
        "    if p['Spending_Trend']    < 0:\n",
        "        signals.append(f\"Tendance dépense décroissante\")\n",
        "\n",
        "    risk = 'Élevé' if len(signals) >= 3 else ('Moyen' if signals else 'Faible')\n",
        "    signals_str = \"\\n\".join(f\"  ⚠️ {s}\" for s in signals) or \"  ✅ Aucun signal critique\"\n",
        "\n",
        "    prompt = f\"\"\"Analyse churn (en français). Niveau : {risk}\n",
        "Signaux :\\n{signals_str}\n",
        "Profil : Recency {p['Recency']:.0f}j | Frequency {p['Frequency']:.0f} | Monetary £{p['Monetary']:.0f}\n",
        "Segment : {SEGMENT_NAMES.get(int(p['Cluster']), 'Inconnu')}\n",
        "\n",
        "Structure :\n",
        "🚨 Niveau : {risk}\n",
        "📋 Diagnostic : [2 phrases]\n",
        "🎯 Actions 7 jours : [2 actions]\n",
        "📅 Actions 30 jours : [2 actions]\n",
        "📊 KPIs : [2 métriques]\"\"\"\n",
        "\n",
        "    return call_groq(prompt, max_tokens=400)\n",
        "\n",
        "for cid in customer_clean.nlargest(3, 'Recency').index:\n",
        "    print(f\"\\n{'='*55}\\nChurn — Client {cid}\\n{'='*55}\")\n",
        "    print(analyze_churn_risk(cid))"
      ]

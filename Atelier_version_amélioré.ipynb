      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "RFM_Segment\n",
            "Champions              1139\n",
            "Lost                   1065\n",
            "Loyal Customers         821\n",
            "At Risk                 442\n",
            "Potential Loyalists     351\n",
            "Recent Customers        319\n",
            "Hibernating             142\n",
            "Cant Lose Them           59\n",
            "Name: count, dtype: int64\n"
          ]
        }
      ],
      "source": [
        "def rfm_score(df):\n",
        "    \"\"\"Assign quintile-based R, F, M scores (5 = best). [Kotler / Blattberg 2008]\"\"\"\n",
        "    r = pd.qcut(df['Recency'],  q=5, labels=[5,4,3,2,1]).astype(int)  # lower R = better\n",
        "    f = pd.qcut(df['Frequency'].rank(method='first'), q=5, labels=[1,2,3,4,5]).astype(int)\n",
        "    m = pd.qcut(df['Monetary'].rank(method='first'),  q=5, labels=[1,2,3,4,5]).astype(int)\n",
        "    return r, f, m\n",
        "\n",
        "r_score, f_score, m_score = rfm_score(customer_df)\n",
        "customer_df['R_Score'] = r_score.values\n",
        "customer_df['F_Score'] = f_score.values\n",
        "customer_df['M_Score'] = m_score.values\n",
        "customer_df['RFM_Score'] = (customer_df['R_Score'].astype(str)\n",
        "                            + customer_df['F_Score'].astype(str)\n",
        "                            + customer_df['M_Score'].astype(str))\n",
        "\n",
        "def assign_rfm_segment(row):\n",
        "    r, f = row['R_Score'], row['F_Score']\n",
        "    if r >= 4 and f >= 4:\n",
        "        return 'Champions'\n",
        "    elif r >= 3 and f >= 3:\n",
        "        return 'Loyal Customers'\n",
        "    elif r >= 4 and f <= 2:\n",
        "        return 'Recent Customers'\n",
        "    elif r >= 3 and f <= 2:\n",
        "        return 'Potential Loyalists'\n",
        "    elif r == 2 and f >= 3:\n",
        "        return 'At Risk'\n",
        "    elif r <= 2 and f >= 4:\n",
        "        return 'Cant Lose Them'\n",
        "    elif r <= 2 and f <= 2:\n",
        "        return 'Lost'\n",
        "    else:\n",
        "        return 'Hibernating'\n",
        "\n",
        "customer_df['RFM_Segment'] = customer_df.apply(assign_rfm_segment, axis=1)\n",
        "print(customer_df['RFM_Segment'].value_counts())\n"
      ]
    },

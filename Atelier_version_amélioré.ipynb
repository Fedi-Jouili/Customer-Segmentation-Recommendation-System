      "source": [
        "# ── Pre-build O(1) lookup structures (built ONCE before the loop) ────────────\n",
        "# Root cause of timeout: df_sales[df_sales['StockCode'] == sc] inside a loop\n",
        "# = full column scan per customer per product. Fix: dict + numpy slicing.\n",
        "\n",
        "stock_to_desc = (\n",
        "    df_sales.groupby('StockCode')['Description']\n",
        "    .agg(lambda x: x.value_counts().index[0])\n",
        "    .to_dict()\n",
        ")\n",
        "\n",
        "item_codes  = item_sim_df.index.tolist()\n",
        "item_pos    = {sc: i for i, sc in enumerate(item_codes)}\n",
        "item_sim_np = item_sim_df.values\n",
        "\n",
        "pm_customers = purchase_matrix.index.tolist()\n",
        "pm_cust_pos  = {c: i for i, c in enumerate(pm_customers)}\n",
        "pm_np        = (purchase_matrix.values > 0)\n",
        "\n",
        "cluster_candidates = {\n",
        "    cid: [(sc, item_pos[sc]) for sc in codes if sc in item_pos]\n",
        "    for cid, codes in top_per_cluster.items()\n",
        "}\n",
        "\n",
        "# ── Fast recommendation function ─────────────────────────────────────────────\n",
        "def get_recommendations_fast(customer_id, n=3):\n",
        "    if customer_id not in cid_to_cluster:\n",
        "        return []\n",
        "    cid   = cid_to_cluster[customer_id]\n",
        "    cands = cluster_candidates[cid]\n",
        "\n",
        "    if customer_id in pm_cust_pos:\n",
        "        bought_row = pm_np[pm_cust_pos[customer_id]]\n",
        "        bought_pos = set(np.where(bought_row)[0])\n",
        "    else:\n",
        "        bought_row, bought_pos = None, set()\n",
        "\n",
        "    unseen = [(sc, pos) for sc, pos in cands if pos not in bought_pos]\n",
        "    if not unseen:\n",
        "        return [sc for sc, _ in cands[:n]]\n",
        "\n",
        "    if bought_pos and bought_row is not None:\n",
        "        unseen_pos = np.array([pos for _, pos in unseen], dtype=np.intp)\n",
        "        bought_arr = np.array(list(bought_pos), dtype=np.intp)\n",
        "        scores     = item_sim_np[unseen_pos][:, bought_arr].mean(axis=1)\n",
        "        top_idx    = np.argpartition(scores, -min(n, len(scores)))[-n:]\n",
        "        top_idx    = top_idx[np.argsort(scores[top_idx])[::-1]]\n",
        "        return [unseen[i][0] for i in top_idx]\n",
        "\n",
        "    return [sc for sc, _ in unseen[:n]]\n",
        "\n",
        "# ── Build recommendations_df ─────────────────────────────────────────────────\n",
        "import time as _time\n",
        "_t0 = _time.time()\n",
        "\n",
        "rows = []\n",
        "for cust_id in customer_clean.index:\n",
        "    recs = get_recommendations_fast(cust_id, n=3)\n",
        "    recs += [None] * (3 - len(recs))\n",
        "    rows.append({\n",
        "        'CustomerID': cust_id,\n",
        "        'Cluster':    cid_to_cluster[cust_id],\n",
        "        'Rec1_Code':  recs[0], 'Rec1_Desc': stock_to_desc.get(recs[0], recs[0]) if recs[0] else None,\n",
        "        'Rec2_Code':  recs[1], 'Rec2_Desc': stock_to_desc.get(recs[1], recs[1]) if recs[1] else None,\n",
        "        'Rec3_Code':  recs[2], 'Rec3_Desc': stock_to_desc.get(recs[2], recs[2]) if recs[2] else None,\n",
        "    })\n",
        "\n",
        "recommendations_df = pd.DataFrame(rows)\n",
        "print(f\"✅ Done in {_time.time()-_t0:.1f}s — {len(recommendations_df):,} customers\")\n",
        "recommendations_df.head(5)\n"
      ]
    },

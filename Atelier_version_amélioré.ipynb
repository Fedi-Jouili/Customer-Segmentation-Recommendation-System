        "# ── 2.1  Completeness ────────────────────────────────────────────────────────\n",
        "missing = df_raw.isnull().sum()\n",
        "missing_pct = (missing / len(df_raw) * 100).round(2)\n",
        "completeness = pd.DataFrame({'Missing #': missing, 'Missing %': missing_pct})\n",
        "print(completeness[completeness['Missing #'] > 0])\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 3))\n",
        "completeness[completeness['Missing #'] > 0]['Missing %'].plot(\n",
        "    kind='barh', ax=ax, color=['#e06c75', '#61afef'])\n",
        "ax.set_title('Missing Values (%)'); ax.set_xlabel('%')\n",
        "plt.tight_layout(); plt.show()\n"
      ]

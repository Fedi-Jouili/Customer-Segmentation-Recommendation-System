      "source": [
        "# ── 1.2  Temporal features ───────────────────────────────────────────────────\n",
        "df_tmp = df_raw.copy()\n",
        "df_tmp['InvoiceDate'] = pd.to_datetime(df_tmp['InvoiceDate'])\n",
        "df_tmp['YearMonth']   = df_tmp['InvoiceDate'].dt.to_period('M')\n",
        "df_tmp['DayOfWeek']   = df_tmp['InvoiceDate'].dt.day_name()\n",
        "df_tmp['Hour']        = df_tmp['InvoiceDate'].dt.hour\n",
        "\n",
        "# Monthly transactions\n",
        "monthly = df_tmp.groupby('YearMonth').size().reset_index(name='Transactions')\n",
        "monthly['YearMonth'] = monthly['YearMonth'].astype(str)\n",
        "\n",
        "fig = px.bar(monthly, x='YearMonth', y='Transactions',\n",
        "             title='📅 Monthly Transaction Volume (2010–2011)',\n",
        "             color='Transactions', color_continuous_scale='Oranges',\n",
        "             labels={'YearMonth': 'Month'})\n",
        "fig.update_layout(xaxis_tickangle=-45)\n",
        "fig.show()\n"
      ]
    },

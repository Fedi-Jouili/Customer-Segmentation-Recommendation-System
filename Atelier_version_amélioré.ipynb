      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Outliers detected : 217 (5.0%)\n",
            "Retained for clust: 4,121\n"
          ]
        }
      ],
      "source": [
        "# ── Features for clustering (exclude scoring columns) ────────────────────────\n",
        "FEAT_COLS = ['Recency','Frequency','Monetary','AOV','Avg_Quantity_Per_Order',\n",
        "             'Unique_Products_Purchased','Cancellation_Rate',\n",
        "             'Avg_Days_Between_Purchases','Preferred_Shopping_Hour',\n",
        "             'Preferred_Day_of_Week','Weekend_Purchase_Ratio',\n",
        "             'Spending_Trend','Monthly_Spending_Std','Is_UK']\n",
        "\n",
        "X = customer_df[FEAT_COLS].copy()\n",
        "\n",
        "# ── 5.1  IsolationForest outlier detection ───────────────────────────────────\n",
        "# Contamination = 0.05 → expect ~5% of rows to be anomalous\n",
        "iso = IsolationForest(contamination=0.05, random_state=RANDOM_STATE)\n",
        "X['IF_Label'] = iso.fit_predict(X)\n",
        "\n",
        "outliers_df = customer_df[X['IF_Label'] == -1].copy()\n",
        "X_clean     = X[X['IF_Label'] == 1].drop(columns='IF_Label')\n",
        "print(f\"Outliers detected : {len(outliers_df):,} ({len(outliers_df)/len(X)*100:.1f}%)\")\n",
        "print(f\"Retained for clust: {len(X_clean):,}\")\n"
      ]
    },

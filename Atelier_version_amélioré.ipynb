            "Best k by Gap Statistic: 2\n"
          ]
        }
      ],
      "source": [
        "# ── 6.3  Gap Statistic [Tibshirani et al., 2001] ─────────────────────────────\n",
        "def gap_statistic(X, k_range, B=10, random_state=42):\n",
        "    \"\"\"\n",
        "    Compute Gap Statistic for each k.\n",
        "    Gap(k) = E*[log W_k] − log W_k\n",
        "    where W_k is the within-cluster sum of squares and E* is expectation\n",
        "    over reference (uniform) data distributions.\n",
        "    [Tibshirani, Walther & Hastie, 2001]\n",
        "    \"\"\"\n",
        "    rng = np.random.RandomState(random_state)\n",
        "    gaps, s_k = [], []\n",
        "\n",
        "    X_min, X_max = X.min(axis=0), X.max(axis=0)\n",
        "\n",
        "    for k in k_range:\n",
        "        km = KMeans(n_clusters=k, random_state=random_state, n_init=5)\n",
        "        km.fit(X)\n",
        "        W_k = km.inertia_\n",
        "\n",
        "        W_kb_list = []\n",
        "        for _ in range(B):\n",
        "            X_ref = rng.uniform(X_min, X_max, size=X.shape)\n",
        "            km_ref = KMeans(n_clusters=k, random_state=random_state, n_init=5)\n",
        "            km_ref.fit(X_ref)\n",
        "            W_kb_list.append(np.log(km_ref.inertia_))\n",
        "\n",
        "        gap = np.mean(W_kb_list) - np.log(W_k)\n",
        "        sdk = np.std(W_kb_list) * np.sqrt(1 + 1/B)\n",
        "        gaps.append(gap); s_k.append(sdk)\n",
        "\n",
        "    return np.array(gaps), np.array(s_k)\n",
        "\n",
        "print(\"Computing Gap Statistic (B=10 reference distributions)…\")\n",
        "gaps, s_k = gap_statistic(X_pca, list(K_RANGE), B=10, random_state=RANDOM_STATE)\n",
        "\n",
        "# Best k: smallest k such that Gap(k) ≥ Gap(k+1) - s_k+1\n",
        "best_k_gap = list(K_RANGE)[0]\n",
        "for i in range(len(gaps)-1):\n",
        "    if gaps[i] >= gaps[i+1] - s_k[i+1]:\n",
        "        best_k_gap = list(K_RANGE)[i]\n",
        "        break\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9,4))\n",
        "ax.errorbar(list(K_RANGE), gaps, yerr=s_k, marker='o', color='purple',\n",
        "            ecolor='gray', capsize=4)\n",
        "ax.axvline(x=best_k_gap, color='red', linestyle='--', label=f'Best k={best_k_gap}')\n",
        "ax.set_xlabel('k'); ax.set_ylabel('Gap Statistic')\n",
        "ax.set_title('Gap Statistic [Tibshirani et al., 2001]'); ax.legend()\n",
        "plt.tight_layout(); plt.show()\n",
        "print(f\"Best k by Gap Statistic: {best_k_gap}\")\n"
      ]
    },

        "# ── Suppress warnings ──────────────────────────────────────────────────────\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ── Core data manipulation ───────────────────────────────────────────────────\n",
        "import numpy as np                          # Vectorised computation\n",
        "import pandas as pd                         # DataFrame API\n",
        "\n",
        "# ── Visualisation — static ──────────────────────────────────────────────────\n",
        "import matplotlib.pyplot as plt             # Base plotting\n",
        "import matplotlib.cm as cm\n",
        "import matplotlib.gridspec as gridspec\n",
        "import seaborn as sns                       # Statistical plots\n",
        "\n",
        "# ── Visualisation — interactive ─────────────────────────────────────────────\n",
        "import plotly.express as px                 # High-level Plotly\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "# ── Time series decomposition ───────────────────────────────────────────────\n",
        "from statsmodels.tsa.seasonal import seasonal_decompose\n",
        "\n",
        "# ── ML — preprocessing ──────────────────────────────────────────────────────\n",
        "from sklearn.preprocessing import RobustScaler   # Robust to outliers [Müller & Guido, 2016]\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.ensemble import IsolationForest\n",
        "\n",
        "# ── ML — clustering ─────────────────────────────────────────────────────────\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import (silhouette_score, silhouette_samples,\n",
        "                             calinski_harabasz_score, davies_bouldin_score,\n",
        "                             adjusted_rand_score)\n",
        "\n",
        "# ── Yellowbrick — cluster visualisation ─────────────────────────────────────\n",
        "try:\n",
        "    from yellowbrick.cluster import KElbowVisualizer, SilhouetteVisualizer\n",
        "    YELLOWBRICK = True\n",
        "except ImportError:\n",
        "    YELLOWBRICK = False\n",
        "    print(\"yellowbrick not installed — falling back to manual elbow/silhouette\")\n",
        "\n",
        "# ── HDBSCAN ─────────────────────────────────────────────────────────────────\n",
        "try:\n",
        "    import hdbscan                           # [Campello et al., 2013]\n",
        "    HDBSCAN_AVAILABLE = True\n",
        "except ImportError:\n",
        "    HDBSCAN_AVAILABLE = False\n",
        "    print(\"hdbscan not installed — HDBSCAN section will be skipped\")\n",
        "\n",
        "# ── VIF ─────────────────────────────────────────────────────────────────────\n",
        "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
        "\n",
        "# ── Sparse matrices & cosine similarity ─────────────────────────────────────\n",
        "from scipy.sparse import csr_matrix\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "# ── Regression for spending trend ────────────────────────────────────────────\n",
        "from scipy.stats import linregress\n",
        "\n",
        "# ── Standard library ─────────────────────────────────────────────────────────\n",
        "import os, time, logging, re\n",
        "from itertools import product as iterproduct\n",
        "\n",
        "# ── Anthropic GenAI SDK ──────────────────────────────────────────────────────\n",
        "try:\n",
        "    import anthropic\n",
        "    ANTHROPIC_AVAILABLE = True\n",
        "except ImportError:\n",
        "    ANTHROPIC_AVAILABLE = False\n",
        "    print(\"anthropic SDK not installed — GenAI section will use mock output\")\n",
        "\n",
        "# ── Global config ────────────────────────────────────────────────────────────\n",
        "RANDOM_STATE = 42\n",
        "np.random.seed(RANDOM_STATE)\n",
        "pd.set_option('display.max_columns', 50)\n",
        "pd.set_option('display.float_format', '{:.2f}'.format)\n",
        "sns.set_theme(style='whitegrid', palette='muted', font_scale=1.1)\n",
        "plt.rcParams.update({'figure.dpi': 120, 'figure.figsize': (12, 5)})\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format='%(levelname)s | %(message)s')\n",
        "logger = logging.getLogger(__name__)\n",
        "\n",
        "print(\"✅ All libraries loaded successfully\")\n"
      ]

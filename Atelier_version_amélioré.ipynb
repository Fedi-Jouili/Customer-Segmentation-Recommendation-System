            ]
          },
          "execution_count": 22,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "def spending_trend_slope(series):\n",
        "    \"\"\"\n",
        "    Fit a linear regression on monthly spending and return the slope.\n",
        "    Positive slope → growing spend; negative → declining [Gupta & Lehmann, 2005].\n",
        "    \"\"\"\n",
        "    if len(series) < 2:\n",
        "        return 0.0\n",
        "    x = np.arange(len(series))\n",
        "    slope, *_ = linregress(x, series.values)\n",
        "    return slope\n",
        "\n",
        "# ── Customer-level aggregations ───────────────────────────────────────────────\n",
        "cust = df_sales.groupby('CustomerID')\n",
        "\n",
        "# RFM\n",
        "rfm = cust.agg(\n",
        "    Recency   = ('InvoiceDate', lambda x: (SNAPSHOT_DATE - x.max()).days),\n",
        "    Frequency = ('InvoiceNo',   'nunique'),\n",
        "    Monetary  = ('Revenue',     'sum')\n",
        ").reset_index()\n",
        "\n",
        "# Behavioural features\n",
        "behav = cust.agg(\n",
        "    Avg_Quantity_Per_Order   = ('Quantity', 'mean'),\n",
        "    Unique_Products_Purchased = ('StockCode', 'nunique'),\n",
        "    Preferred_Shopping_Hour  = ('InvoiceDate', lambda x: x.dt.hour.mode().iloc[0]),\n",
        "    Preferred_Day_of_Week    = ('InvoiceDate', lambda x: x.dt.dayofweek.mode().iloc[0]),\n",
        "    Weekend_Purchase_Ratio   = ('InvoiceDate', lambda x: (x.dt.dayofweek >= 5).mean()),\n",
        ").reset_index()\n",
        "\n",
        "# AOV\n",
        "rfm['AOV'] = rfm['Monetary'] / rfm['Frequency']\n",
        "\n",
        "# Avg days between purchases\n",
        "def avg_days_between(dates):\n",
        "    sorted_d = sorted(dates)\n",
        "    if len(sorted_d) < 2:\n",
        "        return np.nan\n",
        "    diffs = [(sorted_d[i+1]-sorted_d[i]).days for i in range(len(sorted_d)-1)]\n",
        "    return np.mean(diffs)\n",
        "\n",
        "inter_purchase = cust['InvoiceDate'].apply(avg_days_between).reset_index()\n",
        "inter_purchase.columns = ['CustomerID','Avg_Days_Between_Purchases']\n",
        "\n",
        "# Cancellation rate\n",
        "total_inv = df[df['CustomerID'].notna()].groupby('CustomerID')['InvoiceNo'].nunique()\n",
        "cancel_inv = cancelled_df[cancelled_df['CustomerID'].notna()].groupby(\n",
        "    'CustomerID')['InvoiceNo'].nunique()\n",
        "cancel_rate = (cancel_inv / total_inv).fillna(0).reset_index()\n",
        "cancel_rate.columns = ['CustomerID','Cancellation_Rate']\n",
        "cancel_rate['CustomerID'] = cancel_rate['CustomerID'].astype(int)\n",
        "\n",
        "# Spending trend slope & std\n",
        "trend = (monthly_spend.groupby('CustomerID')['Revenue']\n",
        "         .apply(spending_trend_slope).reset_index())\n",
        "trend.columns = ['CustomerID','Spending_Trend']\n",
        "std_spend = (monthly_spend.groupby('CustomerID')['Revenue']\n",
        "             .std().fillna(0).reset_index())\n",
        "std_spend.columns = ['CustomerID','Monthly_Spending_Std']\n",
        "\n",
        "# Geographic flag\n",
        "uk_flag = (df_sales.groupby('CustomerID')['Country']\n",
        "           .apply(lambda x: int((x == 'United Kingdom').all()))\n",
        "           .reset_index())\n",
        "uk_flag.columns = ['CustomerID','Is_UK']\n",
        "\n",
        "# ── Merge all features ────────────────────────────────────────────────────────\n",
        "customer_df = (rfm\n",
        "    .merge(behav, on='CustomerID')\n",
        "    .merge(inter_purchase, on='CustomerID')\n",
        "    .merge(cancel_rate, on='CustomerID', how='left')\n",
        "    .merge(trend, on='CustomerID', how='left')\n",
        "    .merge(std_spend, on='CustomerID', how='left')\n",
        "    .merge(uk_flag, on='CustomerID', how='left'))\n",
        "\n",
        "customer_df['Cancellation_Rate']   = customer_df['Cancellation_Rate'].fillna(0)\n",
        "customer_df['Spending_Trend']      = customer_df['Spending_Trend'].fillna(0)\n",
        "customer_df['Monthly_Spending_Std']= customer_df['Monthly_Spending_Std'].fillna(0)\n",
        "customer_df['Avg_Days_Between_Purchases'] = customer_df['Avg_Days_Between_Purchases'].fillna(\n",
        "    customer_df['Avg_Days_Between_Purchases'].median())\n",
        "\n",
        "customer_df = customer_df.set_index('CustomerID')\n",
        "print(f\"customer_df shape: {customer_df.shape}\")\n",
        "print(f\"Features: {customer_df.columns.tolist()}\")\n",
        "customer_df.describe().T\n"
      ]
    },

        "def explain_recommendations(customer_id):\n",
        "    if customer_id not in customer_clean.index:\n",
        "        return \"Client introuvable.\"\n",
        "    p   = customer_clean.loc[customer_id]\n",
        "    row = recommendations_df[recommendations_df['CustomerID'] == customer_id]\n",
        "    if row.empty:\n",
        "        return \"Pas de recommandations.\"\n",
        "    row  = row.iloc[0]\n",
        "    recs = \"\\n\".join(\n",
        "        f\"  {i}. {row.get(f'Rec{i}_Desc','')}\"\n",
        "        for i in range(1,4) if pd.notna(row.get(f'Rec{i}_Code'))\n",
        "    )\n",
        "    prompt = f\"\"\"Client e-commerce :\n",
        "- {p['Frequency']:.0f} commandes | £{p['Monetary']:.0f} dépensés | AOV £{p['AOV']:.0f}\n",
        "- Segment : {SEGMENT_NAMES.get(int(p['Cluster']), 'Inconnu')}\n",
        "\n",
        "Produits recommandés :\n",
        "{recs}\n",
        "\n",
        "Écris un message personnalisé (3-4 phrases) commençant par \"Nous avons sélectionné pour vous…\".\"\"\"\n",
        "\n",
        "    return call_groq(prompt, max_tokens=300)\n",
        "\n",
        "for cid in customer_clean.sample(5, random_state=42).index:\n",
        "    print(f\"\\n── Client {cid} | Cluster {cid_to_cluster.get(cid,'?')} ──\")\n",
        "    print(explain_recommendations(cid))"

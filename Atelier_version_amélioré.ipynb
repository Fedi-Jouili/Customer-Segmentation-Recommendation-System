        "# ── 7.3  3D interactive cluster visualisation ────────────────────────────────\n",
        "fig3d = px.scatter_3d(\n",
        "    x=X_pca_df['PC1'], y=X_pca_df['PC2'], z=X_pca_df['PC3'],\n",
        "    color=kmeans_labels.astype(str),\n",
        "    title=f'🔵 K-Means Clusters (k={OPTIMAL_K}) in PCA Space',\n",
        "    labels={'x':'PC1','y':'PC2','z':'PC3','color':'Cluster'},\n",
        "    opacity=0.6\n",
        ")\n",
        "fig3d.show()\n"
      ]

        "---\n",
        "## Section 6 — Clustering\n",
        "\n",
        "**Primary**: K-Means with k determined by Elbow + Silhouette + Gap Statistic  \n",
        "**Alternative**: HDBSCAN [Campello et al., 2013] — density-based, robust to non-spherical clusters\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 32,
      "id": "c565a791",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 473
        },
        "id": "c565a791",
        "outputId": "2b502045-aa51-4b05-9223-630c58f9e011"
      },
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 1080x480 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "# ── 6.1  Elbow method ────────────────────────────────────────────────────────\n",
        "K_RANGE = range(2, 11)\n",
        "inertias = []\n",
        "for k in K_RANGE:\n",
        "    km = KMeans(n_clusters=k, random_state=RANDOM_STATE, n_init=10)\n",
        "    km.fit(X_pca)\n",
        "    inertias.append(km.inertia_)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9, 4))\n",
        "ax.plot(list(K_RANGE), inertias, marker='o', color='steelblue')\n",
        "ax.set_xlabel('k (number of clusters)'); ax.set_ylabel('Inertia (WCSS)')\n",
        "ax.set_title('Elbow Method for Optimal k')\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 33,
      "id": "bfeeeb0e",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 664
        },
        "id": "bfeeeb0e",
        "outputId": "3da8bb5b-d98b-4840-8ac4-8aab0c58bd83"
      },
      "outputs": [
        {
          "name": "stdout",

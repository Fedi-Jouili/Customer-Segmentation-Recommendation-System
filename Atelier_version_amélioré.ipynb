        "# ── 1.5  Geographic distribution ─────────────────────────────────────────────\n",
        "country_rev = (df_tmp[df_tmp['Revenue'] > 0]\n",
        "               .groupby('Country')['Revenue']\n",
        "               .sum().reset_index().sort_values('Revenue', ascending=False))\n",
        "\n",
        "# Pie chart — top 10\n",
        "fig1 = px.pie(country_rev.head(10), values='Revenue', names='Country',\n",
        "              title='🌍 Revenue Share by Country (Top 10)',\n",
        "              color_discrete_sequence=px.colors.sequential.RdBu)\n",
        "fig1.show()\n",
        "\n",
        "# Choropleth\n",
        "fig2 = px.choropleth(country_rev, locations='Country',\n",
        "                     locationmode='country names',\n",
        "                     color='Revenue',\n",
        "                     title='🗺️ Revenue Choropleth Map',\n",
        "                     color_continuous_scale='Oranges')\n",
        "fig2.show()\n"
      ]
    },

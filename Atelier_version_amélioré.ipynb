      "source": [
        "# ── 5.3  VIF — multicollinearity check ───────────────────────────────────────\n",
        "vif_data = pd.DataFrame({\n",
        "    'Feature': FEAT_COLS,\n",
        "    'VIF': [variance_inflation_factor(X_scaled.values, i)\n",
        "            for i in range(X_scaled.shape[1])]\n",
        "}).sort_values('VIF', ascending=False)\n",
        "\n",
        "print(\"Variance Inflation Factors (VIF > 10 indicates multicollinearity):\")\n",
        "print(vif_data.to_string(index=False))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8,5))\n",
        "vif_data.plot(kind='barh', x='Feature', y='VIF', ax=ax, color='steelblue', legend=False)\n",
        "ax.axvline(x=10, color='red', linestyle='--', label='VIF=10 threshold')\n",
        "ax.set_title('VIF per Feature'); ax.legend()\n",
        "plt.tight_layout(); plt.show()\n"
      ]
    },
